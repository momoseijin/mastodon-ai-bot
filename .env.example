# Mastodonアプリ登録時に取得したアクセストークン(bot用アカウントで発行)
MASTODON_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 自サーバのベースURL(末尾スラッシュなし)
MASTODON_API_BASE_URL=https://your-domain.example

# 自サーバのドメイン(acctのドメイン比較に使用。上とホスト名部分は基本同じ)
MASTODON_DOMAIN=your-domain.example

# Anthropic Console で発行したAPIキー
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用するモデル(コスト重視ならHaiku系がおすすめ)
CLAUDE_MODEL=claude-haiku-5-5

# 1時間あたりの最大返信数(コスト・スパム対策)
MAX_REPLIES_PER_HOUR=30

# 1返信あたりの最大出力トークン数
MAX_OUTPUT_TOKENS=400

# Web検索ツールを有効にするか(true/false)。検索実行ごとに別途課金が発生するため既定はfalse
ENABLE_WEB_SEARCH=false

# Web検索を有効にした場合、1回の返信生成あたりの検索実行回数の上限(コスト対策)
WEB_SEARCH_MAX_USES=2
